# ---- Server (apps/server) ----
# Port the Node server listens on. Most hosts (Render, Railway, Fly) set this for you.
PORT=3000

# Minimum players needed before the host can start. Set to 1 for solo testing.
MIN_PLAYERS=2

# Only needed if the frontend is served from a DIFFERENT origin than the server.
# Comma-separated list, e.g. https://tilt-mayhem.vercel.app
# Leave empty when the server serves the built frontend itself (recommended).
CORS_ORIGIN=

# ---- Web (apps/web, read at build/dev time by Vite) ----
# Public URL phones should open (used for the QR code + join link).
# Useful in dev when the host screen is on localhost but phones use a tunnel/LAN URL,
# e.g. https://random-name.trycloudflare.com or http://192.168.1.20:5173
VITE_PUBLIC_URL=

# Socket.IO server URL if it is on a different origin than the web app. Leave empty for same origin.
VITE_SERVER_URL=
